#!/usr/bin/env sh
#
# Hook pre-commit
#
# Roda as verificações de qualidade nos arquivos PHP do commit:
# 1. Laravel Pint: formata os arquivos e os adiciona de novo ao commit.
# 2. Rector (dry-run): bloqueia se houver mudanças propostas (aplique com `composer rector`).
# 3. Larastan: análise estática do projeto; bloqueia se houver erros.

staged_php_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')

if [ -z "$staged_php_files" ]; then
	exit 0
fi

# Usa o PHP da máquina quando disponível; caso contrário, o container do Sail.
if command -v php > /dev/null 2>&1; then
	php_runner='php'
else
	php_runner='./vendor/bin/sail php'
fi

fail() {
	echo "" >&2
	echo "✖ Commit bloqueado: $1" >&2
	exit 1
}

# ---------------------------------------------------------------------------
# 1. Laravel Pint
# ---------------------------------------------------------------------------

echo "→ Pint: formatando os arquivos PHP do commit..."

fully_staged_files=''
partially_staged_files=''

for file in $staged_php_files; do
	if git diff --name-only -- "$file" | grep -q .; then
		partially_staged_files="$partially_staged_files $file"
	else
		fully_staged_files="$fully_staged_files $file"
	fi
done

if [ -n "$fully_staged_files" ]; then
	# shellcheck disable=SC2086
	$php_runner vendor/bin/pint $fully_staged_files || fail "o Pint não conseguiu formatar os arquivos."
	# shellcheck disable=SC2086
	git add $fully_staged_files
fi

# Arquivos com alterações fora do commit não são formatados automaticamente,
# para não incluir no commit trechos que não foram adicionados.
if [ -n "$partially_staged_files" ]; then
	# shellcheck disable=SC2086
	$php_runner vendor/bin/pint --test $partially_staged_files \
		|| fail "rode 'composer lint' e adicione os arquivos formatados ($partially_staged_files )."
fi

# ---------------------------------------------------------------------------
# 2. Rector (dry-run)
# ---------------------------------------------------------------------------

echo "→ Rector: verificando mudanças propostas..."

# shellcheck disable=SC2086
$php_runner vendor/bin/rector process --dry-run --no-progress-bar $staged_php_files \
	|| fail "o Rector propõe mudanças. Revise com 'composer rector:dry' e aplique com 'composer rector'."

# ---------------------------------------------------------------------------
# 3. Larastan
# ---------------------------------------------------------------------------

echo "→ Larastan: analisando o código..."

$php_runner vendor/bin/phpstan analyse --memory-limit=1G --no-progress \
	|| fail "o Larastan encontrou erros. Rode 'composer analyse' para ver os detalhes."

echo "✔ Verificações concluídas."
